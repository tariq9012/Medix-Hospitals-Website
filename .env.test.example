# Copy to .env.test (git-ignored) to configure the test tooling. Real environment variables win over
# this file. Tests NEVER read DATABASE_URL — only the variables below.

# REQUIRED for any DB-backed test. A DISPOSABLE database whose name contains the word "test".
# `npm run test:db:setup` creates it if missing (the role needs CREATEDB) or you can pre-create an
# EMPTY database. A populated database that this tooling did not create is REFUSED.
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/medix_test

# Where the E2E runner serves the app (it starts and stops the server itself).
# TEST_BASE_URL=http://127.0.0.1:4173

# Accounts created by `npm run db:seed` / the E2E fixtures (defaults shown).
# TEST_PATIENT_EMAIL=tariq.khan@example.com
# TEST_DOCTOR_EMAIL=dr.ahmed.raza@medix.example
# TEST_PATIENT_B_EMAIL=patient.b@example.com
# TEST_DOCTOR_B_EMAIL=dr.sara.khan@medix.example
# TEST_HOSPITAL_ADMIN_EMAIL=admin@medixcentral.example
# TEST_ADMIN_EMAIL=platform.admin@medix.example

# Shared password of the seeded FICTIONAL accounts in the test database. Defaults to the documented
# development-only seed password; override it if you prefer.
# TEST_PASSWORD=

# Allow a non-local test database host (e.g. a throwaway cloud branch). Name/sentinel rules still apply.
# TEST_ALLOW_REMOTE_DB=1

# E2E (Python) — interpreter to use if `python3`/`python` is not what you want.
# TEST_PYTHON=python
