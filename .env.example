# Copy this file to .env and fill in real values. NEVER commit .env (it is git-ignored).
# This file documents the APPLICATION environment. Test variables live in .env.test.example.
# Variable reference: README -> "Environment variables".

# ── Required (development and production) ─────────────────────────────────────────────────
# PostgreSQL connection string (Drizzle ORM + drizzle-kit).
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Use a database that is NOT your test database — tests use TEST_DATABASE_URL only.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/medix

# Signs/hashes session tokens. REQUIRED in production (min 32 chars); development falls back to an
# insecure default with a warning. Generate one:  openssl rand -base64 32
#   PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
SESSION_SECRET=

# ── Required in production ────────────────────────────────────────────────────────────────
# Public URL of the app (used to build password-reset links). Must be the real URL in production.
APP_URL=http://localhost:3000

# ── Optional ──────────────────────────────────────────────────────────────────────────────
# Days a login session stays valid (default 7).
AUTH_SESSION_MAX_AGE_DAYS=7

# Outbound email. In development mail is NEVER sent — it is printed to the server console.
# In production MAIL_PROVIDER must name a supported provider or email flows fail loudly.
MAIL_FROM="Medix <no-reply@medix.example>"
MAIL_PROVIDER=

# Private storage for uploaded medical documents. Keep it OUTSIDE the web root; on ephemeral hosts
# (containers/serverless) point it at a persistent volume.
MEDICAL_UPLOAD_DIR=./private-uploads
MEDICAL_UPLOAD_MAX_MB=10

# Realtime (SSE) tuning — defaults are fine for most deployments.
# REALTIME_HEARTBEAT_MS=25000
# REALTIME_SESSION_RECHECK_MS=60000

# Local debugging only (ignored when NODE_ENV=production): include bound SQL parameter values in
# logged database errors. Off by default because parameters can contain private data.
# MEDIX_LOG_SQL_PARAMS=1

# Dev seed (npm run db:seed): optional override of the shared development password, and an explicit
# opt-in to seed a NON-local database. The seed always refuses NODE_ENV=production.
# SEED_PASSWORD=
# MEDIX_ALLOW_REMOTE_SEED=true

# Admin bootstrap (npm run admin:create) — see src/db/create-admin.ts.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ALLOW_ADMIN_CREATE=true   # required only when NODE_ENV=production
